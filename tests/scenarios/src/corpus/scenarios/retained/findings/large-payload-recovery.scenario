application todo
parameter payload_bytes: integer = 899643
about "An Event with a ${payload_bytes}-byte string crosses offline storage and backend synchronization."

client client-a with session-a
client client-b with session-b
participants both = client-a/session-a, client-b/session-b

note "Commit the payload while Client A cannot reach the backend."

disconnect client-a

client-a/session-a runs createTodo with
  id: "large-payload"
  text: repeat("x", payload_bytes)

reconnect client-a

expect both:
  pending resolved
  eventlogs converge
  todos converges
  todos contains ids "large-payload"
