application todo
seed 3004
parameter event_count: integer = 426
about "Two Clients distribute and converge ${event_count} uniquely identified Events."

client client-1 with session-1
client client-2 with session-2
participants writers = client-1/session-1, client-2/session-2

note "Generate deterministic createTodo actions here and distribute them across all Clients."

repeat event_count times as event:
  let writer = choose(writers, key: "target")
  let variant = randomInt(1000, key: "text-variant")

  writer runs createTodo with
    id: "many-writer-${pad(event, 3)}"
    text: "Distributed write ${event} · variant ${variant}"

expect writers:
  pending resolved
  eventlogs converge
  todos converges
  todos contains ids "many-writer-001", "many-writer-${pad(event_count, 3)}"
