application todo
seed 3001
parameter pending_count: integer = 400
about "An offline Client rebases ${pending_count} pending Events over one confirmed remote Event."

client client-a with session-a
client client-b with session-b
participants both = client-a/session-a, client-b/session-b

note "Client A accumulates a large pending tail while Client B confirms independent history."

disconnect client-a

repeat pending_count times as item:
  let variant = randomInt(1000, key: "text-variant")

  client-a/session-a runs createTodo with
    id: "pending-${pad(item, 3)}"
    text: "Offline pending item ${item} · variant ${variant}"

client-b/session-b runs createTodo with
  id: "remote-confirmed"
  text: "Confirmed ahead of the pending tail"

settle client-b/session-b

note "Client A reconnects and rebases its pending tail over the confirmed remote write."

reconnect client-a

expect both:
  pending resolved
  eventlogs converge
  todos converges
  todos contains ids "pending-001", "pending-${pad(pending_count, 3)}", "remote-confirmed"
