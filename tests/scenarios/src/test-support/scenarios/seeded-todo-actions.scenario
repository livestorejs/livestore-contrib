application todo
seed 1445
about "A seeded Scenario expands a readable repetition into concrete todo actions."

client client-a with session-a

note "Generate concrete createTodo actions here in the Scenario and dispatch them in order."

repeat 40 times as item:
  let variant = randomInt(1000, key: "text-variant")

  client-a/session-a runs createTodo with
    id: "seeded-todo-${pad(item, 3)}"
    text: "Seeded task ${item} · variant ${variant}"

  expect all finish
