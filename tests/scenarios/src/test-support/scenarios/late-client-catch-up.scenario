application todo
seed 1446
parameter history_count: integer = 8
about "A new Client starts from empty local state after history exists, writes, and converges."

client client-a with session-a

note "The initial Client commits and confirms history before the second Client exists."

repeat history_count times as item:
  let variant = randomInt(1000, key: "text-variant")

  client-a/session-a runs createTodo with
    id: "history-${pad(item, 3)}"
    text: "Before the late Client ${item} · variant ${variant}"

settle client-a/session-a

note "Client B is created from empty local state and both Clients write before final stabilization."

create client client-b with session-b
participants both = client-a/session-a, client-b/session-b

concurrently:
  client-a/session-a runs createTodo with
    id: "after-join-a"
    text: "Written by the established Client"

  client-b/session-b runs createTodo with
    id: "after-join-b"
    text: "Written by the late Client"

expect both:
  pending resolved
  eventlogs converge
  todos converges
  todos contains ids "history-001", "history-002", "history-003", "history-004", "history-005", "history-006", "history-007", "history-008", "after-join-a", "after-join-b"
