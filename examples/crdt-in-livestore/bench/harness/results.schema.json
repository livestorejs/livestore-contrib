{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livestore.dev/schemas/crdt-benchmark-result-v1.json",
  "title": "LiveStore CRDT benchmark evidence and TAX results",
  "oneOf": [
    { "$ref": "#/$defs/benchmarkResult" },
    { "$ref": "#/$defs/taxRow" },
    { "$ref": "#/$defs/notCountable" }
  ],
  "$defs": {
    "notApplicable": {
      "type": "object",
      "required": ["_tag", "reason"],
      "properties": {
        "_tag": { "const": "not-applicable" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "compactEvidence": {
      "oneOf": [
        {
          "type": "object",
          "required": ["_tag", "hash", "count", "reference"],
          "properties": {
            "_tag": { "const": "summary" },
            "hash": { "type": "string", "minLength": 1 },
            "count": { "type": "integer", "minimum": 1 },
            "reference": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        { "$ref": "#/$defs/externalEvidence" }
      ]
    },
    "sampleEvidence": {
      "oneOf": [
        {
          "type": "object",
          "required": ["_tag", "hash", "count", "reference"],
          "properties": {
            "_tag": { "const": "summary" },
            "hash": { "type": "string", "minLength": 1 },
            "count": { "type": "integer", "minimum": 1 },
            "reference": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["_tag", "hash", "count", "reference", "samples"],
          "properties": {
            "_tag": { "const": "inline" },
            "hash": { "type": "string", "minLength": 1 },
            "count": { "type": "integer", "minimum": 1 },
            "reference": { "type": "string", "minLength": 1 },
            "samples": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "type": "number" } }
          },
          "additionalProperties": false
        },
        { "$ref": "#/$defs/externalEvidence" }
      ]
    },
    "externalEvidence": {
      "type": "object",
      "required": ["_tag", "path", "hash", "count", "encoding"],
      "properties": {
        "_tag": { "const": "external" },
        "path": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 },
        "encoding": { "type": "string", "minLength": 1 },
        "compression": { "enum": ["gzip"] }
      },
      "additionalProperties": false
    },
    "nonNegativeDistribution": {
      "type": "object",
      "required": ["count", "total", "min", "max", "avg", "variance", "stddev", "p50", "p95", "p99", "median", "evidence"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "total": { "type": "number", "minimum": 0 },
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 },
        "avg": { "type": "number", "minimum": 0 },
        "variance": { "type": "number", "minimum": 0 },
        "stddev": { "type": "number", "minimum": 0 },
        "p50": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "p99": { "type": "number", "minimum": 0 },
        "median": { "type": "number", "minimum": 0 },
        "evidence": { "$ref": "#/$defs/sampleEvidence" }
      },
      "additionalProperties": false
    },
    "compactNonNegativeDistribution": {
      "type": "object",
      "required": ["count", "total", "min", "max", "avg", "variance", "stddev", "p50", "p95", "p99", "median", "evidence"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "total": { "type": "number", "minimum": 0 },
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 },
        "avg": { "type": "number", "minimum": 0 },
        "variance": { "type": "number", "minimum": 0 },
        "stddev": { "type": "number", "minimum": 0 },
        "p50": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "p99": { "type": "number", "minimum": 0 },
        "median": { "type": "number", "minimum": 0 },
        "evidence": { "$ref": "#/$defs/compactEvidence" }
      },
      "additionalProperties": false
    },
    "signedDistribution": {
      "type": "object",
      "required": ["count", "total", "min", "max", "avg", "variance", "stddev", "p50", "p95", "p99", "median", "evidence"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "total": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "avg": { "type": "number" },
        "variance": { "type": "number", "minimum": 0 },
        "stddev": { "type": "number", "minimum": 0 },
        "p50": { "type": "number" },
        "p95": { "type": "number" },
        "p99": { "type": "number" },
        "median": { "type": "number" },
        "evidence": { "$ref": "#/$defs/sampleEvidence" }
      },
      "additionalProperties": false
    },
    "numberMetric": {
      "oneOf": [
        {
          "type": "object",
          "required": ["_tag", "value"],
          "properties": { "_tag": { "const": "measured" }, "value": { "type": "number", "minimum": 0 } },
          "additionalProperties": false
        },
        { "$ref": "#/$defs/notApplicable" }
      ]
    },
    "compactDistributionMetric": {
      "oneOf": [
        {
          "type": "object",
          "required": ["_tag", "value"],
          "properties": { "_tag": { "const": "measured" }, "value": { "$ref": "#/$defs/compactNonNegativeDistribution" } },
          "additionalProperties": false
        },
        { "$ref": "#/$defs/notApplicable" }
      ]
    },
    "distributionMetric": {
      "oneOf": [
        {
          "type": "object",
          "required": ["_tag", "value"],
          "properties": { "_tag": { "const": "measured" }, "value": { "$ref": "#/$defs/nonNegativeDistribution" } },
          "additionalProperties": false
        },
        { "$ref": "#/$defs/notApplicable" }
      ]
    },
    "memoryMetric": {
      "oneOf": [
        {
          "type": "object",
          "required": ["_tag", "value"],
          "properties": { "_tag": { "const": "measured" }, "value": { "$ref": "#/$defs/signedDistribution" } },
          "additionalProperties": false
        },
        { "$ref": "#/$defs/notApplicable" }
      ]
    },
    "convergenceMetric": {
      "oneOf": [
        {
          "type": "object",
          "required": ["_tag", "value"],
          "properties": {
            "_tag": { "const": "measured" },
            "value": {
              "type": "object",
              "required": ["converged", "oracleMatched", "stateCount", "canonicalDigests", "oracleDigest", "mismatchedIndices", "oracleMismatchedIndices"],
              "properties": {
                "converged": { "type": "boolean" },
                "oracleMatched": { "type": "boolean" },
                "stateCount": { "type": "integer", "minimum": 1 },
                "canonicalDigests": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "oracleDigest": { "type": "string", "minLength": 1 },
                "mismatchedIndices": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
                "oracleMismatchedIndices": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
                "mismatchArtifact": { "$ref": "#/$defs/externalEvidence" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        { "$ref": "#/$defs/notApplicable" }
      ]
    },
    "conformanceMetric": {
      "oneOf": [
        {
          "type": "object",
          "required": ["_tag", "value"],
          "properties": {
            "_tag": { "const": "measured" },
            "value": {
              "type": "object",
              "required": ["passed", "suite", "scenarioCount"],
              "properties": {
                "passed": { "type": "boolean" },
                "suite": {
                  "type": "object",
                  "required": ["id", "version", "hash"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "version": { "type": "string", "minLength": 1 },
                    "hash": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                },
                "scenarioCount": { "type": "integer", "minimum": 0 },
                "failureArtifact": { "$ref": "#/$defs/externalEvidence" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        { "$ref": "#/$defs/notApplicable" }
      ]
    },
    "runtime": {
      "type": "object",
      "required": ["nodeVersion", "platform", "arch"],
      "properties": {
        "nodeVersion": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "cpu": {
          "type": "object",
          "required": ["model", "count"],
          "properties": { "model": { "type": "string", "minLength": 1 }, "count": { "type": "integer", "minimum": 1 } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "measurementProtocol": {
      "type": "object",
      "required": ["warmups", "iterations", "clock", "gc", "statistics"],
      "properties": {
        "warmups": { "type": "integer", "minimum": 0 },
        "iterations": { "type": "integer", "minimum": 1 },
        "clock": { "type": "string", "minLength": 1 },
        "gc": {
          "type": "object",
          "required": ["requested"],
          "properties": { "requested": { "type": "boolean" } },
          "additionalProperties": false
        },
        "statistics": {
          "type": "object",
          "required": ["median", "quantiles", "variance"],
          "properties": {
            "median": { "type": "string", "minLength": 1 },
            "quantiles": { "type": "string", "minLength": 1 },
            "variance": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "wireProtocol": {
      "type": "object",
      "required": ["boundary", "encoding", "framing"],
      "properties": {
        "boundary": { "type": "string", "minLength": 1 },
        "encoding": { "type": "string", "minLength": 1 },
        "framing": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["pairedRunId", "trace", "crdt", "versions", "measurementProtocol", "wireProtocol"],
      "properties": {
        "pairedRunId": { "type": "string", "minLength": 1 },
        "trace": {
          "type": "object",
          "required": ["id", "hash", "deliveryCount"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "hash": { "type": "string", "minLength": 1 },
            "deliveryCount": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "crdt": {
          "type": "object",
          "required": ["name", "version"],
          "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        },
        "versions": {
          "type": "object",
          "required": ["harness", "protocol", "library"],
          "properties": {
            "harness": { "type": "string", "minLength": 1 },
            "protocol": { "type": "string", "minLength": 1 },
            "library": { "type": "string", "minLength": 1 },
            "liveStore": {
              "type": "object",
              "required": ["version", "commit"],
              "properties": { "version": { "type": "string", "minLength": 1 }, "commit": { "type": "string", "minLength": 1 } },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "measurementProtocol": { "$ref": "#/$defs/measurementProtocol" },
        "wireProtocol": { "$ref": "#/$defs/wireProtocol" }
      },
      "additionalProperties": false
    },
    "axes": {
      "type": "object",
      "required": ["technology", "arm", "documentSizeBytes", "editCount", "concurrency", "offlineBranchDurations"],
      "properties": {
        "technology": { "type": "string", "minLength": 1 },
        "arm": { "enum": ["standalone", "embedded", "reference-only", "crdv", "embedded-over-standalone"] },
        "documentSizeBytes": { "type": "integer", "minimum": 0 },
        "editCount": { "type": "integer", "minimum": 0 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "offlineBranchDurations": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } }
      },
      "additionalProperties": false
    },
    "embeddedEvidence": {
      "type": "object",
      "required": ["payloadInflation", "orderingEffect", "logGrowth"],
      "properties": {
        "payloadInflation": {
          "type": "object",
          "required": ["nativeBytes", "base64Bytes", "jsonBytes"],
          "properties": {
            "nativeBytes": { "type": "integer", "minimum": 1 },
            "base64Bytes": { "type": "integer", "minimum": 1 },
            "jsonBytes": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "orderingEffect": {
          "oneOf": [
            {
              "type": "object",
              "required": ["_tag", "value"],
              "properties": {
                "_tag": { "const": "measured" },
                "value": {
                  "type": "object",
                  "required": ["mode", "serializedOperationCount", "evidence"],
                  "properties": {
                    "mode": { "const": "single-writer-total-order" },
                    "serializedOperationCount": { "type": "integer", "minimum": 1 },
                    "evidence": { "$ref": "#/$defs/compactEvidence" }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            { "$ref": "#/$defs/notApplicable" }
          ]
        },
        "logGrowth": {
          "type": "object",
          "required": ["withoutCompaction", "checkpoints"],
          "properties": {
            "withoutCompaction": { "const": true },
            "checkpoints": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["editCount", "historyBytes"],
                "properties": {
                  "editCount": { "type": "integer", "minimum": 1 },
                  "historyBytes": { "type": "integer", "minimum": 0 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "benchmarkResult": {
      "type": "object",
      "required": ["schemaVersion", "kind", "id", "version", "seed", "runtime", "axes", "metrics"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "benchmark-result" },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "seed": { "type": ["string", "integer"] },
        "runtime": { "$ref": "#/$defs/runtime" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "axes": {
          "allOf": [
            { "$ref": "#/$defs/axes" },
            { "properties": { "arm": { "enum": ["standalone", "embedded", "reference-only", "crdv"] } } }
          ]
        },
        "embedded": { "$ref": "#/$defs/embeddedEvidence" },
        "metrics": {
          "type": "object",
          "required": ["wire", "atRest", "timing", "memory", "convergence", "conformance"],
          "properties": {
            "wire": {
              "type": "object",
              "required": ["perOp", "totalTransferredBytes"],
              "properties": {
                "perOp": { "$ref": "#/$defs/compactDistributionMetric" },
                "totalTransferredBytes": { "$ref": "#/$defs/numberMetric" }
              },
              "additionalProperties": false
            },
            "atRest": {
              "type": "object",
              "required": ["snapshotBytes", "historyBytes"],
              "properties": {
                "snapshotBytes": { "$ref": "#/$defs/numberMetric" },
                "historyBytes": { "$ref": "#/$defs/numberMetric" }
              },
              "additionalProperties": false
            },
            "timing": {
              "type": "object",
              "required": ["encodeMs", "decodeMs", "fullReplayMs"],
              "properties": {
                "encodeMs": { "$ref": "#/$defs/distributionMetric" },
                "decodeMs": { "$ref": "#/$defs/distributionMetric" },
                "fullReplayMs": { "$ref": "#/$defs/distributionMetric" }
              },
              "additionalProperties": false
            },
            "memory": {
              "type": "object",
              "required": ["rssDeltaBytes", "heapUsedDeltaBytes", "gcAvailable", "gcUsed"],
              "properties": {
                "rssDeltaBytes": { "$ref": "#/$defs/memoryMetric" },
                "heapUsedDeltaBytes": { "$ref": "#/$defs/memoryMetric" },
                "gcAvailable": { "type": "boolean" },
                "gcUsed": { "type": "boolean" }
              },
              "additionalProperties": false
            },
            "convergence": { "$ref": "#/$defs/convergenceMetric" },
            "conformance": { "$ref": "#/$defs/conformanceMetric" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "taxMetric": {
      "oneOf": [
        {
          "type": "object",
          "required": ["_tag", "ratio", "numerator", "denominator"],
          "properties": {
            "_tag": { "const": "measured" },
            "ratio": { "type": "number" },
            "numerator": { "type": "number" },
            "denominator": { "type": "number" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["_tag", "reason", "numerator", "denominator"],
          "properties": {
            "_tag": { "const": "not-applicable" },
            "reason": { "type": "string", "minLength": 1 },
            "numerator": { "type": "number" },
            "denominator": { "type": "number" }
          },
          "additionalProperties": false
        }
      ]
    },
    "taxRow": {
      "type": "object",
      "required": ["schemaVersion", "kind", "pairedRunId", "trace", "numeratorId", "denominatorId", "axes", "metrics"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "tax-row" },
        "pairedRunId": { "type": "string", "minLength": 1 },
        "trace": {
          "type": "object",
          "required": ["id", "hash", "deliveryCount"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "hash": { "type": "string", "minLength": 1 },
            "deliveryCount": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "numeratorId": { "type": "string", "minLength": 1 },
        "denominatorId": { "type": "string", "minLength": 1 },
        "axes": {
          "allOf": [
            { "$ref": "#/$defs/axes" },
            { "properties": { "arm": { "const": "embedded-over-standalone" } } }
          ]
        },
        "metrics": {
          "type": "object",
          "required": ["wire", "atRest", "timing", "memory"],
          "properties": {
            "wire": {
              "type": "object",
              "required": ["perOp", "totalTransferredBytes"],
              "properties": {
                "perOp": {
                  "type": "object",
                  "required": ["avg", "p50", "p95", "p99"],
                  "properties": {
                    "avg": { "$ref": "#/$defs/taxMetric" },
                    "p50": { "$ref": "#/$defs/taxMetric" },
                    "p95": { "$ref": "#/$defs/taxMetric" },
                    "p99": { "$ref": "#/$defs/taxMetric" }
                  },
                  "additionalProperties": false
                },
                "totalTransferredBytes": { "$ref": "#/$defs/taxMetric" }
              },
              "additionalProperties": false
            },
            "atRest": {
              "type": "object",
              "required": ["snapshotBytes", "historyBytes"],
              "properties": {
                "snapshotBytes": { "$ref": "#/$defs/taxMetric" },
                "historyBytes": { "$ref": "#/$defs/taxMetric" }
              },
              "additionalProperties": false
            },
            "timing": {
              "type": "object",
              "required": ["encodeMs", "decodeMs", "fullReplayMs"],
              "properties": {
                "encodeMs": { "$ref": "#/$defs/taxMetric" },
                "decodeMs": { "$ref": "#/$defs/taxMetric" },
                "fullReplayMs": { "$ref": "#/$defs/taxMetric" }
              },
              "additionalProperties": false
            },
            "memory": {
              "type": "object",
              "required": ["rssDeltaBytes", "heapUsedDeltaBytes"],
              "properties": {
                "rssDeltaBytes": { "$ref": "#/$defs/taxMetric" },
                "heapUsedDeltaBytes": { "$ref": "#/$defs/taxMetric" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "notCountable": {
      "type": "object",
      "required": ["schemaVersion", "kind", "_tag", "numeratorId", "denominatorId", "reasons"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "tax-assessment" },
        "_tag": { "const": "not-countable" },
        "numeratorId": { "type": ["string", "null"] },
        "denominatorId": { "type": ["string", "null"] },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["code", "path", "message"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
