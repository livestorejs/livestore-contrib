    "@effect/platform": "0.96.1",
    "@effect/rpc": "0.75.1",
    "@livestore/adapter-node": "workspace:^",
    "@livestore/common": "link:../../../repos/livestore/packages/@livestore/common",
    "@livestore/livestore": "link:../../../repos/livestore/packages/@livestore/livestore",
    "@livestore/peer-deps": "link:../../../repos/livestore/packages/@livestore/peer-deps",
    "@livestore/utils": "link:../../../repos/livestore/packages/@livestore/utils",
    "effect": "3.21.2"
  },
  "devDependencies": {
    "@livestore/utils-dev": "link:../../../repos/livestore/packages/@livestore/utils-dev",
    "@types/node": "25.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "peerDependencies": {
    "@effect/ai": "^0.35.0",
    "@effect/cli": "^0.75.1",
    "@effect/cluster": "^0.58.2",
    "@effect/experimental": "^0.60.0",
    "@effect/opentelemetry": "^0.63.0",
    "@effect/platform": "^0.96.1",
    "@effect/platform-browser": "^0.76.0",
    "@effect/platform-bun": "^0.89.0",
    "@effect/platform-node": "^0.106.0",
    "@effect/printer": "^0.49.0",
    "@effect/printer-ansi": "^0.49.0",
    "@effect/rpc": "^0.75.1",
    "@effect/sql": "^0.51.1",
    "@effect/typeclass": "^0.40.0",
    "@effect/vitest": "^0.29.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/resources": "^2.2.0",
    "@standard-schema/spec": "^1.1.0",
    "effect": "^3.21.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@mixedbread/cli",
      "@myobie/pty",
      "@parcel/watcher",
      "cbor-extract",
      "dtrace-provider",
      "esbuild",
      "msgpackr-extract",
      "node-pty",
      "protobufjs",
      "puppeteer",
      "sharp",
      "unix-dgram",
      "workerd"
    ]
  },
  "$genie": {
    "source": "package.json.genie.ts",
    "warning": "DO NOT EDIT - changes will be overwritten",
    "workspaceClosureDirs": [
      "packages/@livestore/adapter-node",
      "packages/@livestore/cli",
      "repos/livestore/packages/@livestore/adapter-web",
